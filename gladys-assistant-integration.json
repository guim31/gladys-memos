{
  "manifest_version": 1,
  "type": "device",
  "name": "Memos",
  "description": {
    "en": "Memos in Gladys: write memos from scenes, show the latest ones, react to a new memo.",
    "fr": "Memos dans Gladys : écrire des mémos depuis les scènes, voir les derniers, réagir à un nouveau.",
    "de": "Memos in Gladys: Notizen aus Szenen schreiben, die neuesten zeigen, auf neue reagieren.",
    "es": "Memos en Gladys: escribir memos desde escenas, ver los últimos y reaccionar a uno nuevo."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-memos:1.0.0",
  "gladys_version": ">=5.2.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-memos/main/cover.png",
  "categories": ["services"],
  "transports": ["local", "cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Connect Memos",
        "fr": "Connecter Memos",
        "de": "Memos verbinden",
        "es": "Conectar Memos"
      },
      "description": {
        "en": "Enter the address of your Memos server (port 5230 by default) and an access token: in Memos, open Settings → Access Tokens and create one. The integration reads your counters and newest memos, and writes the memos your scenes send it. Tested with Memos 0.31.",
        "fr": "Saisissez l'adresse de votre serveur Memos (port 5230 par défaut) et un jeton d'accès : dans Memos, ouvrez Paramètres → Jetons d'accès et créez-en un. L'intégration lit vos compteurs et vos derniers mémos, et écrit les mémos que vos scènes lui envoient. Testée avec Memos 0.31.",
        "de": "Gib die Adresse deines Memos-Servers (standardmäßig Port 5230) und ein Zugangstoken ein: Öffne in Memos Einstellungen → Zugangstoken und erstelle eins. Die Integration liest deine Zähler und neuesten Notizen und schreibt die Notizen, die deine Szenen ihr schicken. Getestet mit Memos 0.31.",
        "es": "Introduzca la dirección de su servidor Memos (puerto 5230 por defecto) y un token de acceso: en Memos, abra Configuración → Tokens de acceso y cree uno. La integración lee sus contadores y sus últimos memos, y escribe los memos que le envían sus escenas. Probada con Memos 0.31."
      },
      "links": [
        {
          "url": "https://usememos.com/docs",
          "label": {
            "en": "Memos documentation",
            "fr": "Documentation de Memos",
            "de": "Memos-Dokumentation",
            "es": "Documentación de Memos"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "Memos address",
        "fr": "Adresse de Memos",
        "de": "Memos-Adresse",
        "es": "Dirección de Memos"
      },
      "placeholder": {
        "en": "e.g. 192.168.1.50:5230",
        "fr": "ex. 192.168.1.50:5230",
        "de": "z. B. 192.168.1.50:5230",
        "es": "p. ej. 192.168.1.50:5230"
      },
      "required": true,
      "default": ""
    },
    {
      "key": "access_token",
      "type": "secret",
      "label": {
        "en": "Access token",
        "fr": "Jeton d'accès",
        "de": "Zugangstoken",
        "es": "Token de acceso"
      },
      "description": {
        "en": "Memos → Settings → Access Tokens → Create. The memos are written as this user.",
        "fr": "Memos → Paramètres → Jetons d'accès → Créer. Les mémos sont écrits au nom de cet utilisateur.",
        "de": "Memos → Einstellungen → Zugangstoken → Erstellen. Die Notizen werden als dieser Benutzer geschrieben.",
        "es": "Memos → Configuración → Tokens de acceso → Crear. Los memos se escriben en nombre de este usuario."
      },
      "required": true
    },
    {
      "key": "refresh_minutes",
      "type": "select",
      "label": {
        "en": "Read Memos every",
        "fr": "Lire Memos toutes les",
        "de": "Memos lesen alle",
        "es": "Leer Memos cada"
      },
      "description": {
        "en": "New memos are announced to scenes at the next read.",
        "fr": "Les nouveaux mémos sont signalés aux scènes à la lecture suivante.",
        "de": "Neue Notizen werden den Szenen beim nächsten Lesen gemeldet.",
        "es": "Los nuevos memos se comunican a las escenas en la siguiente lectura."
      },
      "required": false,
      "default": "5",
      "options": [
        {
          "value": "1",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "5",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        },
        {
          "value": "15",
          "label": {
            "en": "15 minutes",
            "fr": "15 minutes",
            "de": "15 Minuten",
            "es": "15 minutos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 minutes",
            "fr": "30 minutes",
            "de": "30 Minuten",
            "es": "30 minutos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "60 minutes",
            "fr": "60 minutes",
            "de": "60 Minuten",
            "es": "60 minutos"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of names and messages",
        "fr": "Langue des noms et des messages",
        "de": "Sprache der Namen und Meldungen",
        "es": "Idioma de los nombres y mensajes"
      },
      "description": {
        "en": "Feature names are set when a device is added to Gladys.",
        "fr": "Les noms des fonctionnalités sont fixés à l'ajout de l'appareil dans Gladys.",
        "de": "Die Namen der Funktionen werden beim Hinzufügen des Geräts zu Gladys festgelegt.",
        "es": "Los nombres de las funciones se fijan al añadir el dispositivo a Gladys."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "memo_created",
      "label": {
        "en": "New memo",
        "fr": "Nouveau mémo",
        "de": "Neue Notiz",
        "es": "Nuevo memo"
      },
      "description": {
        "en": "A memo is written in Memos (by you, or shared by another user). The memos of this integration are not announced.",
        "fr": "Un mémo est écrit dans Memos (par vous, ou partagé par un autre utilisateur). Les mémos de cette intégration ne sont pas signalés.",
        "de": "Eine Notiz wird in Memos geschrieben (von dir oder von einem anderen Benutzer geteilt). Die Notizen dieser Integration werden nicht gemeldet.",
        "es": "Se escribe un memo en Memos (por usted, o compartido por otro usuario). Los memos de esta integración no se comunican."
      },
      "fields": [
        {
          "key": "author",
          "type": "string",
          "required": false,
          "label": {
            "en": "Author (empty: anyone)",
            "fr": "Auteur (vide : tout le monde)",
            "de": "Autor (leer: alle)",
            "es": "Autor (vacío: cualquiera)"
          },
          "description": {
            "en": "Memos username, e.g. camille.",
            "fr": "Nom d'utilisateur Memos, par exemple camille.",
            "de": "Memos-Benutzername, z. B. camille.",
            "es": "Nombre de usuario de Memos, por ejemplo camille."
          }
        },
        {
          "key": "visibility",
          "type": "select",
          "required": false,
          "label": {
            "en": "Visibility (empty: all)",
            "fr": "Visibilité (vide : toutes)",
            "de": "Sichtbarkeit (leer: alle)",
            "es": "Visibilidad (vacío: todas)"
          },
          "options": [
            {
              "value": "private",
              "label": {
                "en": "Private (default)",
                "fr": "Privé (par défaut)",
                "de": "Privat (Standard)",
                "es": "Privado (predeterminado)"
              }
            },
            {
              "value": "protected",
              "label": {
                "en": "Protected: signed-in users",
                "fr": "Protégé : utilisateurs connectés",
                "de": "Geschützt: angemeldete Benutzer",
                "es": "Protegido: usuarios registrados"
              }
            },
            {
              "value": "public",
              "label": {
                "en": "Public",
                "fr": "Public",
                "de": "Öffentlich",
                "es": "Público"
              }
            }
