    {
      "key": "pin_latest",
      "label": {
        "en": "Pin the latest memo of a tag",
        "fr": "Épingler le dernier mémo d'une étiquette",
        "de": "Neueste Notiz eines Tags anpinnen",
        "es": "Fijar el último memo de una etiqueta"
      },
      "description": {
        "en": "Pins (or unpins) the newest memo carrying the tag, e.g. this week's shopping list.",
        "fr": "Épingle (ou désépingle) le mémo le plus récent qui porte l'étiquette, par exemple la liste de courses de la semaine.",
        "de": "Pinnt die neueste Notiz mit dem Tag an (oder löst sie), z. B. die Einkaufsliste der Woche.",
