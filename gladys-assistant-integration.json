  "widgets": [
    {
      "key": "memos",
      "label": {
        "en": "Memos",
        "fr": "Memos",
        "de": "Memos",
        "es": "Memos"
      },
      "description": {
        "en": "Counters, the newest memos (of a tag if you want) and a button to write one.",
        "fr": "Compteurs, derniers mémos (d'une étiquette si vous voulez) et un bouton pour en écrire un.",
        "de": "Zähler, die neuesten Notizen (eines Tags, wenn du willst) und ein Knopf zum Schreiben.",
        "es": "Contadores, los últimos memos (de una etiqueta si quiere) y un botón para escribir uno."
      },
      "icon": "file-text",
      "action_timeout_seconds": 30,
      "settings": [
        {
          "key": "tag",
          "type": "string",
          "required": false,
