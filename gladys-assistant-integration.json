  "scene_actions": [
    {
      "key": "create_memo",
      "label": {
        "en": "Write a memo in Memos",
        "fr": "Écrire un mémo dans Memos",
        "de": "Notiz in Memos schreiben",
        "es": "Escribir un memo en Memos"
      },
      "description": {
        "en": "Writes a memo (Markdown), private unless chosen otherwise: a house journal, a reminder.",
        "fr": "Écrit un mémo (Markdown), privé sauf choix contraire : journal de la maison, rappel.",
        "de": "Schreibt eine Notiz (Markdown), privat, außer du wählst anders: Haus-Tagebuch, Erinnerung.",
        "es": "Escribe un memo (Markdown), privado salvo que elija otra cosa: diario de la casa, recordatorio."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "content",
          "type": "string",
          "required": true,
          "label": {
            "en": "Text of the memo",
            "fr": "Texte du mémo",
            "de": "Text der Notiz",
            "es": "Texto del memo"
          },
          "placeholder": {
            "en": "e.g. Garage door left open",
            "fr": "ex. Porte du garage restée ouverte",
            "de": "z. B. Garagentor offen gelassen",
            "es": "p. ej. Puerta del garaje abierta"
          }
        },
        {
          "key": "tags",
          "type": "string",
          "required": false,
          "label": {
            "en": "Tags (optional)",
            "fr": "Étiquettes (facultatif)",
            "de": "Tags (optional)",
            "es": "Etiquetas (opcional)"
          },
          "placeholder": {
            "en": "e.g. home, journal",
            "fr": "ex. maison, journal",
            "de": "z. B. haus, tagebuch",
            "es": "p. ej. casa, diario"
          },
          "description": {
            "en": "Separated by commas, without #: added at the end of the memo.",
            "fr": "Séparées par des virgules, sans # : ajoutées à la fin du mémo.",
            "de": "Durch Kommas getrennt, ohne #: am Ende der Notiz angefügt.",
            "es": "Separadas por comas, sin #: se añaden al final del memo."
          }
        },
        {
          "key": "visibility",
          "type": "select",
          "required": false,
          "default": "private",
          "label": {
            "en": "Visibility",
            "fr": "Visibilité",
            "de": "Sichtbarkeit",
            "es": "Visibilidad"
          },
          "options": [
            {
              "value": "private",
              "label": {
                "en": "Private (default)",
                "fr": "Privé (par défaut)",
                "de": "Privat (Standard)",
                "es": "Privado (predeterminado)"
              }
            },
            {
              "value": "protected",
              "label": {
                "en": "Protected: signed-in users",
                "fr": "Protégé : utilisateurs connectés",
                "de": "Geschützt: angemeldete Benutzer",
                "es": "Protegido: usuarios registrados"
              }
            },
            {
              "value": "public",
              "label": {
                "en": "Public",
                "fr": "Public",
                "de": "Öffentlich",
                "es": "Público"
              }
            }
          ]
        },
        {
          "key": "pinned",
          "type": "boolean",
          "required": false,
          "default": false,
          "label": {
            "en": "Pin the memo",
            "fr": "Épingler le mémo",
            "de": "Notiz anpinnen",
            "es": "Fijar el memo"
          }
        }
      ],
      "outputs": [
        {
          "key": "memo_id",
          "type": "string",
          "label": {
            "en": "Memo id",
            "fr": "Identifiant du mémo",
            "de": "Notiz-ID",
            "es": "Id del memo"
          }
        },
        {
          "key": "title",
          "type": "string",
          "label": {
            "en": "First line",
