            "de": "Erste Zeile",
            "es": "Primera línea"
          }
        },
        {
          "key": "link",
          "type": "string",
          "label": {
            "en": "Link to the memo",
            "fr": "Lien vers le mémo",
            "de": "Link zur Notiz",
            "es": "Enlace al memo"
          }
